[user]
	name = hyoeun Kim
	email = hyosari.kim@gmail.com
[rerere]
	enabled = true
[core]
	editor = zed --wait
[commit]
	verbose = true
[alias]
	ch = checkout
	pl = pull origin
	ph = push origin
	l = log --graph
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(cyan)%h%C(reset) - %C(green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(yellow)%d%C(reset)' --all
[log]
	decorate = true
	graph = true
