tap "heroku/brew"
tap "ngrok/ngrok"
tap "nylas/nylas-cli"
tap "porter-dev/porter"
tap "stripe/stripe-cli"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Cloudflare Tunnel client (formerly Argo Tunnel)
brew "cloudflared"
# Reimplementation of ctags(1)
brew "ctags"
# Modern, maintained replacement for ls
brew "eza"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Core application library for C
brew "glib"
# GNU multiple precision arithmetic library
brew "gmp"
# Open source programming language to build simple/reliable/efficient software
brew "go"
# Improved top (interactive process viewer)
brew "htop"
# ISO/IEC 23008-12:2017 HEIF file format decoder and encoder
brew "libheif"
# Interpreted, interactive, object-oriented programming language
brew "python@3.12"
# Tools and libraries to manipulate images in select formats
brew "imagemagick"
# Simple terminal UI for git commands
brew "lazygit"
# Postgres C API library
brew "libpq"
# YAML Parser
brew "libyaml"
# Interpreted, interactive, object-oriented programming language
brew "python@3.14"
# Next-gen compiler infrastructure
brew "llvm"
# Package manager for the Lua programming language
brew "luarocks"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Open-source, cross-platform JavaScript runtime environment
brew "node"
# Manage multiple Node.js versions
brew "nvm"
# Create, run, and share large language models (LLMs)
brew "ollama"
# Terminal multiplexer
brew "tmux"
# Process manager for Procfile-based applications and tmux
brew "overmind"
# Execute binaries from Python packages in isolated environments
brew "pipx"
# Fast, disk space efficient package manager
brew "pnpm"
# Object-relational database system
brew "postgresql@16"
# Python version management
brew "pyenv"
# Install various Ruby versions and implementations
brew "ruby-build"
# Ruby version manager
brew "rbenv"
# Persistent key-value database, with built-in net interface
brew "redis", restart_service: :changed
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# CLI proxy that minimizes LLM token consumption (used by Claude Code rtk hook)
brew "rtk"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Generator for LS_COLORS with support for multiple color themes
brew "vivid"
# JavaScript package manager
brew "yarn"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Additional completion definitions for zsh
brew "zsh-completions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"
# Everything you need to get started with Heroku
brew "heroku/brew/heroku"
# Nylas Command Line Utility
brew "nylas/nylas-cli/nylas"
# Deploy your applications into your own cloud account
brew "porter-dev/porter/porter"
# Stripe CLI utility
brew "stripe/stripe-cli/stripe"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Reimagine your terminal
cask "fig"
# Virtual workspace manager
cask "flashspace"
# UI toolkit for building applications for mobile, web and desktop
cask "flutter"
cask "font-caskaydia-mono-nerd-font"
cask "font-d2coding"
cask "font-hack"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-ibm-plex"
cask "font-source-code-pro"
# Reverse proxy, secure introspectable tunnels to localhost
cask "ngrok"
# App that enables mouse-free UI interaction
cask "shortcat"
cargo "fd-find"
